    },
    {
      "name": "jobs",
      "description": "Background job polling"
    },
    {
      "name": "system",
      "description": "Health, doctor, rules"
    },
    {
      "name": "teach",
      "description": "Operator-only teach loop (absent in api-only mode)"
    }
  ]
